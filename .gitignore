# ---- 构建产物 ----
build/
build-*/
cmake-build-*/

# ---- 编译中间产物 ----
*.o
*.a
*.so
*.so.*
*.out
*.gch
*.d

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
compile_commands.json
# Office 打开文档时生成的锁文件(~$xxx.docx),不是内容
~$*
# Python 字节码(scripts/ 里有 .py 工具)
__pycache__/
*.pyc

# ---- 本机密文:绝不提交 ----
# 数据库口令、LLM API Key 一律走环境变量或本地配置文件
.env
*.env
config.local.*
secrets.*

# ---- 运行时产物 ----
*.log
core
core.*
vgcore.*

# 数据库备份:里面有全库数据(含口令哈希),绝不能进仓库
backups/
