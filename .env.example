# SecGuard 环境配置模板
#
# 用法:
#   cp .env.example .env
#   然后改掉所有标着"必改"的值
#
# 注意:.env 里是明文秘密,已经在 .gitignore / .dockerignore 里排除了,
# 绝对不要提交。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
SECGUARD_DB_NAME=secguard
SECGUARD_DB_USER=secguard
SECGUARD_DB_PASS=change-me-strong-password
SECGUARD_DB_POOL=8

# ---------------------------------------------------------------------------
# 鉴权
# ---------------------------------------------------------------------------
# JWT 签名密钥:至少 16 字符,建议 48 字符以上随机串。
# 生成方式:openssl rand -base64 48
# 【必改】用默认值等于没有签名保护。
SECGUARD_JWT_SECRET=change-me-use-openssl-rand-base64-48

# ---------------------------------------------------------------------------
# 管理员名单(逗号分隔)
# ---------------------------------------------------------------------------
# 只有名单里的用户能访问管理接口:
#   /api/alerts、/api/audit/*、/api/analyze/*、/api/rules*
#
# 留空 = 管理接口全部关闭。这是有意的 fail-closed ——
# 忘了配等于关闭,而不是等于敞开(配置类漏洞最常见的形态就是后者)。
#
# 管理员本身也是普通用户:先注册、再登录,用拿到的令牌访问管理接口。
#   curl -X POST $BASE/api/register -d '{"username":"admin","password":"..."}'
#   TOKEN=$(curl -s -X POST $BASE/api/login -d '{"username":"admin","password":"..."}' | jq -r .token)
#   curl -H "Authorization: Bearer $TOKEN" $BASE/api/alerts
SECGUARD_ADMIN_USERS=admin

# ---------------------------------------------------------------------------
# 对外端口
# ---------------------------------------------------------------------------
# 服务器只开这一个端口。没有域名的话用 IP:端口 访问,不需要备案。
SECGUARD_HTTP_PORT=80

# ---------------------------------------------------------------------------
# 日志与防护(一般不用改)
# ---------------------------------------------------------------------------
SECGUARD_LOG_LEVEL=info
SECGUARD_RATE_PER_SEC=200
SECGUARD_RATE_BURST=400
SECGUARD_HIT_THRESHOLD=20
SECGUARD_BAN_SECONDS=1800

# 被封禁的 IP 继续刷请求时,审计记录的最小间隔(秒)。
#
# 为什么需要:实测一个被封的扫描器在 7.5 小时里又发来 28,451 个请求,
# 每个都写一条审计 —— 占全库 79%,全是废记录(action=BLOCK/rule_hit=IP_BANNED),
# 却照样消耗写入和磁盘。
#
# 60 = 同一个被封 IP 每分钟最多记一条。请求仍然被拒、仍计入 requests_blocked,
# 只是不再逐条落库。被压掉的条数在 /metrics 的
# secguard_audit_suppressed_total 里能看到。
# 0 = 记录每一条(旧行为)。
SECGUARD_BAN_AUDIT_INTERVAL=60

# 审计日志保留天数。审计表是"每请求一行",不清会一直涨
# (压测跑 3 分钟写了 320 万行、占 584MB)。0 = 不清理。
SECGUARD_AUDIT_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# AI 分析层(W6)
# ---------------------------------------------------------------------------
# 不开就是纯规则 WAF,开了才有多一层 LLM 判定。
# 没有 API Key 时保持 0;想在服务器上演示又不想花钱,可以设
#   SECGUARD_LLM_PROVIDER=mock
# 但要注意:mock 返回的是固定结构的假结果,只用于验证链路通不通。
SECGUARD_AI_ENABLE=0

# 多久跑一轮(秒)、每轮最多分析多少条、每分钟最多调几次(控成本)
SECGUARD_AI_INTERVAL=120
SECGUARD_AI_BATCH=10
SECGUARD_AI_RPM=10

# 置信度门槛:低于这个值不写告警(只记日志)
SECGUARD_AI_MIN_CONFIDENCE=0.6

# 告警聚合门槛:同一轮里,同一种威胁类型来自至少这么多**不同 IP** 时,
# 合成一条"分布式扫描"告警,而不是每个 IP 各发一条。
#
# 为什么:实测一天 204 条告警里 191 条(93.6%)是敏感文件探测,
# 来自 200 个不同 IP 各打十几下 —— 典型的分布式扫描。
# 逐条告警的结果是真正的 6 条 SQL 注入被彻底淹没。
#
# 0 或 1 = 不聚合(旧行为)。
SECGUARD_AI_MERGE_IPS=3

# 跨轮次去重窗口(小时)。同一个 IP 的同类威胁在这个窗口内再次判定为攻击时,
# 合并进已有告警(累加 log_ids、刷新 last_seen、seen_count+1),而不是新建。
# 0 = 不去重。
SECGUARD_AI_DEDUP_HOURS=24

# LLM 配置。任何 OpenAI 兼容接口都能用。
SECGUARD_LLM_PROVIDER=openai
SECGUARD_LLM_BASE_URL=https://api.deepseek.com/v1
SECGUARD_LLM_MODEL=deepseek-chat
# 【必改】填你自己的 Key。留空则分析层不会启动。
SECGUARD_LLM_KEY=

# ---------------------------------------------------------------------------
# 告警通知
# ---------------------------------------------------------------------------
# 告警写进数据库不会有人主动去看。填一个 HTTP 端点,新告警会 POST 过去。
# 载荷是通用 JSON(event=alert.created,含 ip/severity/confidence/reasoning)。
# 想接钉钉/飞书/Slack,中间加个转发器转换格式即可。
#
# 本地想看看通知长什么样:
#   python3 scripts/webhook_receiver.py 9099
#   SECGUARD_ALERT_WEBHOOK=http://127.0.0.1:9099/hook
#
# 留空 = 不通知(告警仍然落库)。
SECGUARD_ALERT_WEBHOOK=

# 最低推送级别:LOW / MEDIUM / HIGH / CRITICAL。默认 HIGH。
# 设太低会被噪声淹掉,设太高会漏。
SECGUARD_ALERT_MIN_SEVERITY=HIGH

# 推送超时(毫秒)。它跑在分析线程里,不能设太长。
SECGUARD_ALERT_TIMEOUT_MS=3000

# ===========================================================================
# 高级参数(一般不用改)
#
# 这一段是 2026-11-05 补的。原因:代码里能读 63 个环境变量,
# 但 .env.example 只写了 29 个 —— 剩下 36 个使用者根本不知道存在,也就调不动。
#
# 全部注释掉 = 使用代码默认值(下面标注的就是默认值,已从源码核实)。
# 要改就把行首的 # 去掉。
#
# 注意:app 服务用了 env_file: .env,所以只要在这里(或 .env)取消注释,
# 变量就会自动进容器 —— 不需要再改 docker-compose.yml。
# 完整说明见 docs/配置清单.md。
# ===========================================================================

# ---- AI 分析层 ----
# 只看最近多少小时内的记录
# SECGUARD_AI_LOOKBACK_HOURS=24
# 每轮最多调几次 LLM(按 IP 分组)
# SECGUARD_AI_MAX_GROUPS=5
# 启动后等几秒再跑第一轮(避开数据库预热)
# SECGUARD_AI_STARTUP_DELAY=5

# ---- LLM 客户端 ----
# SECGUARD_LLM_TIMEOUT_MS=20000
# SECGUARD_LLM_MAX_RETRIES=2
# SECGUARD_LLM_MAX_TOKENS=512
# 判定类任务要确定性,默认温度压到 0
# SECGUARD_LLM_TEMPERATURE=0.0

# ---- 审计管道 ----
# 1=异步入队+批量落库,0=每请求同步写库(压测对照实验用)
# SECGUARD_AUDIT_ASYNC=1
# 攒多久落一次盘(毫秒)
# SECGUARD_AUDIT_FLUSH_MS=1000

# ---- 检测引擎 ----
# 归一化检测层:1=原始遍+归一化遍,0=只做字面匹配(可一键回滚)
# SECGUARD_ENGINE_NORMALIZE=1
# 最多解几层编码
# SECGUARD_ENGINE_NORMALIZE_ROUNDS=3
# SECGUARD_PATTERN_FILE=rules/attack_patterns.txt
# SECGUARD_ALLOWLIST_FILE=rules/allowlist.conf
# SECGUARD_POLICY_FILE=rules/policy.conf

# ---- Redis ----
# SECGUARD_REDIS_HOST=127.0.0.1
# SECGUARD_REDIS_PORT=6379
# 空=无密码
# SECGUARD_REDIS_PASS=
# SECGUARD_REDIS_DB=0
# SECGUARD_REDIS_POOL=4
# 限流路径上不能久等,超时默认压得很短
# SECGUARD_REDIS_TIMEOUT_MS=300
# 0=关闭 Redis,退化成单机内存限流
# SECGUARD_REDIS_ENABLE=1

# ---- 数据库 ----
# SECGUARD_DB_HOST=127.0.0.1
# SECGUARD_DB_PORT=3306
# SECGUARD_DB_TIMEOUT_MS=3000

# ---- 重放防护 ----
# 1=拒绝没有 nonce/timestamp 的写请求
# SECGUARD_REPLAY_REQUIRE=0
# SECGUARD_REPLAY_WINDOW=300

# ---- 登录防爆破 ----
# SECGUARD_LOGIN_FAIL_LIMIT=5
# SECGUARD_LOGIN_LOCK_SEC=300

# ---- 服务与限流(其他)----
# SECGUARD_BIND=0.0.0.0
# SECGUARD_PORT=8080
# listen 队列长度
# SECGUARD_BACKLOG=512
# 0=按 CPU 核数自动决定
# SECGUARD_THREADS=0
# JWT 有效期(秒)
# SECGUARD_TOKEN_TTL=7200
# 1=信任 X-Forwarded-For(只在前面有 nginx 时开)
# SECGUARD_TRUST_PROXY=0
# 封禁命中计数的窗口(秒)
# SECGUARD_HIT_WINDOW=300
# 规则文件热加载检查间隔(秒)
# SECGUARD_RELOAD_SEC=60
