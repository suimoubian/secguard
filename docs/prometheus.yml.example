#
#       # Redis 降级了:限流和封禁变成各实例各管各的,多实例时防护会失效
#       - alert: SecGuardRedisDegraded
#         expr: secguard_guard_mode_redis == 0
#         for: 2m
#
#       # 审计队列开始丢数据(队列满):说明写入跟不上,可能要调大批量或加索引
#       - alert: SecGuardAuditDropping
#         expr: rate(secguard_audit_dropped_total[5m]) > 0
#         for: 1m
#
#       # 拦截率突然升高:要么真被打,要么规则误报
#       - alert: SecGuardBlockRateSpike
#         expr: |
#           rate(secguard_requests_blocked_total[5m])
#           / rate(secguard_requests_total[5m]) > 0.3
#         for: 5m
#
#       # LLM 调用大量失败:Key 过期、额度用完、或者网络不通
#       - alert: SecGuardLlmFailing
#         expr: rate(secguard_ai_call_errors_total[10m]) > 0.1
#         for: 10m
