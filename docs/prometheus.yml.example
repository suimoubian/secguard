# Prometheus 抓取配置示例
#
# 放到 prometheus.yml 的 scrape_configs 里。
#
# 为什么要带 bearer_token:/metrics 和别的人看的接口一样要求管理员令牌 ——
# 指标里有请求量、连接池占用、封禁次数这些运营信息,不该匿名可读。
#
# 怎么拿长期令牌:
#   用管理员账号登录一次,拿到的 JWT 有效期是 SECGUARD_TOKEN_TTL(默认 2 小时)。
#   要长期采集,两个办法:
#     a) 把 TTL 调长(比如 30 天),缺点是令牌泄露后窗口也长
#     b) 定期重新登录并热更新配置(真实环境常用,但要多写一个同步脚本)
#   演示项目用 a) 就够了,但要知道这是有代价的简化。

scrape_configs:
  - job_name: 'secguard'
    scrape_interval: 15s
    metrics_path: /metrics

    authorization:
      type: Bearer
      credentials: '<把管理员的 JWT 粘这里>'

    static_configs:
      - targets: ['139.199.x.x:8088']

# ---------------------------------------------------------------------------
# 建议配的几条告警规则(Prometheus 的 alerting rules)
# ---------------------------------------------------------------------------
#
# groups:
#   - name: secguard
#     rules:
